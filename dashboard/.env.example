# Go booking API — used server-side only (it has no CORS, the browser never
# hits it directly). Point this at wherever `booking/cmd/api` runs.
BOOKING_API_URL=http://localhost:8080

# LiveKit Cloud — copy these three from ../phone-agent/.env
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
