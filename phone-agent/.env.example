# LiveKit Cloud (Settings -> Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Created in step 4 of README (npm run setup:sip) - needed for outbound calls
SIP_OUTBOUND_TRUNK_ID=

# Your Telnyx phone number in E.164 format (caller ID / inbound number)
SIP_FROM_NUMBER=

# Telnyx SIP connection credentials (Step 1 of README)
# Used by `npm run setup:sip` to fill the trunk JSON templates
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# AI providers
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=

# Receptionist / booking integration (all optional)
# Business name the receptionist answers with (default: SyncDesk)
BUSINESS_NAME=
# Where the booking REST API runs (default: http://localhost:8080)
# BOOKING_API_URL=http://localhost:8080
# How to launch the booking MCP server. Default: ../booking/bin/mcp if it
# exists (build it: `cd booking && go build -o bin/mcp ./cmd/mcp`), else
# "go run ./cmd/mcp". run.sh builds the binary for you.
# BOOKING_MCP_CMD=./bin/mcp
# BOOKING_MCP_CWD=../booking
